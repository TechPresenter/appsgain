Options -Indexes
Options -MultiViews

# ── Security Headers ─────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    # Any cookie that slips out without the flags gets them here.
    Header always edit Set-Cookie "^(?!.*HttpOnly)(.*)$" "$1; HttpOnly"
    Header always edit Set-Cookie "^(?!.*SameSite)(.*)$" "$1; SameSite=Lax"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # microphone=(self) — the chatbot's voice input needs it. An empty list
    # denies the feature to this origin too, so the browser refused the mic
    # before the permission prompt could ever appear. Everything else stays
    # denied outright; (self) grants only this origin, never an embed.
    Header always set Permissions-Policy "geolocation=(), microphone=(self), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=()"
</IfModule>

ServerSignature Off

# ── Protect Sensitive Files ───────────────────────────────
<FilesMatch "(\.htaccess|\.htpasswd|config\.php|config\.secret\.php|bootstrap\.php|db\.php|auth\.php|functions\.php|\.env|composer\.lock|package\.json)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

<FilesMatch "(\.sql|\.log|\.bak|\.git)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ── Rewrite Engine ───────────────────────────────────────
# NOTE: all substitutions below are RELATIVE (no leading slash) so the site
# works unchanged at the document root (https://appsgain.in/) or inside a
# sub-folder (http://localhost/appsgain-website/).
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to sensitive directories
    RewriteRule ^includes/.*$      - [F,L]
    RewriteRule ^database/.*$      - [F,L]
    RewriteRule ^logs/.*$          - [F,L]
    RewriteRule ^admin/includes/.* - [F,L]
    # Applicant CVs carry names, phone numbers and addresses. They are served
    # to signed-in staff by admin/download-resume.php, never as public files.
    RewriteRule ^uploads/resumes/.* - [F,L]
    RewriteRule ^\.git/.*$         - [F,L]

    # ── HTML → PHP 301 Redirects (legacy static site) ─────
    RewriteRule ^index\.html$            index.php            [R=301,L]
    RewriteRule ^about\.html$            about.php            [R=301,L]
    RewriteRule ^services\.html$         services.php         [R=301,L]
    RewriteRule ^projects\.html$         portfolio.php        [R=301,L]
    RewriteRule ^blog\.html$             blog.php             [R=301,L]
    RewriteRule ^faq\.html$              faq.php              [R=301,L]
    RewriteRule ^contact\.html$          contact.php          [R=301,L]
    RewriteRule ^gallery\.html$          gallery.php          [R=301,L]
    RewriteRule ^privacy-policy\.html$   privacy-policy.php   [R=301,L]
    RewriteRule ^terms-of-service\.html$ terms-of-service.php [R=301,L]
    RewriteRule ^cookie-policy\.html$    cookie-policy.php    [R=301,L]

    # Retired training pages -> closest live equivalent
    RewriteRule ^courses(\.html|\.php)?/?$         services.php [R=301,L]
    RewriteRule ^placed-students(\.html|\.php)?/?$ about.php    [R=301,L]

    # Old service HTML slugs -> new /service/ URLs
    RewriteRule ^service-web-development\.html$   service/web-development        [R=301,L]
    RewriteRule ^service-mobile-app\.html$        service/mobile-app-development [R=301,L]
    RewriteRule ^service-custom-software\.html$   service/custom-software        [R=301,L]
    RewriteRule ^service-ai-solutions\.html$      service/ai-solutions           [R=301,L]
    RewriteRule ^service-ecommerce\.html$         service/ecommerce-solutions    [R=301,L]
    RewriteRule ^service-digital-marketing\.html$ service/digital-marketing      [R=301,L]
    RewriteRule ^service-uiux-design\.html$       service/uiux-design            [R=301,L]
    RewriteRule ^service-cloud-devops\.html$      service/cloud-devops           [R=301,L]
    RewriteRule ^service-api-development\.html$   service/api-development        [R=301,L]

    # ── SEO Slug URLs (environment independent) ───────────
    RewriteRule ^blog/([a-z0-9\-]+)/?$      blog-single.php?slug=$1     [L,QSA]
    RewriteRule ^portfolio/([a-z0-9\-]+)/?$ project-single.php?slug=$1  [L,QSA]
    RewriteRule ^service/([a-z0-9\-]+)/?$   service-detail.php?slug=$1  [L,QSA]
    RewriteRule ^product/([a-z0-9\-]+)/?$   product-detail.php?slug=$1  [L,QSA]
    RewriteRule ^app/([a-z0-9\-]+)/?$       app-detail.php?slug=$1      [L,QSA]
    # Canonical About URL (about.php -> /about-us handled in PHP)
    RewriteRule ^about-us/?$                about.php                   [L,QSA]
    RewriteRule ^sitemap\.xml$              sitemap.php                 [L]

    # ── 404 Fallback (works in any sub-folder) ────────────
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ 404.php [L]
</IfModule>

# ── Core Web Vitals & Performance Headers ─────────────────
<IfModule mod_headers.c>
    # Content Security Policy (basic)
    # HSTS is only meaningful over TLS; browsers ignore it on plain http,
    # and sending it locally would pin localhost to https for a year.
    <If "%{HTTPS} == 'on'">
        Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    </If>

    # A real content policy. 'unsafe-inline' is required by the inline
    # handlers and <style> blocks in the templates; removing it means
    # refactoring those first. Sources are still restricted, so an
    # injected <script src> from another origin will not load.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; media-src 'self' https:; connect-src 'self' https://www.google-analytics.com https://www.googletagmanager.com; frame-src 'self' https://www.google.com https://maps.google.com https://www.youtube.com https://www.youtube-nocookie.com; frame-ancestors 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"

    # Isolation headers
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set X-Permitted-Cross-Domain-Policies "none"
    # Cache-Control for static assets
    <FilesMatch "\.(css|js|woff2|woff|ttf|eot)$">
        Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
    </FilesMatch>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
    </FilesMatch>
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "public, max-age=3600, stale-while-revalidate=60"
    </FilesMatch>
    # Remove server version info
    Header unset Server
    Header unset X-Powered-By
    # SEO / Performance
    Header always set Vary "Accept-Encoding"
    Header always set X-DNS-Prefetch-Control "on"
</IfModule>

# ── GZIP / Brotli Compression (Core Web Vitals) ───────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml font/opentype application/font-woff application/font-woff2
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject font/eot font/otf font/ttf
    # Remove browser bugs (only needed for old browsers)
    BrowserMatch ^Mozilla/4 gzip-only-text/html
    BrowserMatch ^Mozilla/4\.0[678] no-gzip
    BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
</IfModule>

# ── Browser Caching (Core Web Vitals — CLS/LCP) ──────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                         "access plus 1 week"
    ExpiresByType image/jpeg               "access plus 6 months"
    ExpiresByType image/png                "access plus 6 months"
    ExpiresByType image/webp               "access plus 6 months"
    ExpiresByType image/gif                "access plus 6 months"
    ExpiresByType image/svg+xml            "access plus 6 months"
    ExpiresByType image/x-icon             "access plus 1 year"
    ExpiresByType text/css                 "access plus 1 month"
    ExpiresByType application/javascript   "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"
    ExpiresByType application/pdf          "access plus 3 months"
    ExpiresByType application/font-woff    "access plus 1 year"
    ExpiresByType application/font-woff2   "access plus 1 year"
    ExpiresByType font/woff                "access plus 1 year"
    ExpiresByType font/woff2               "access plus 1 year"
    ExpiresByType text/html                "access plus 1 hour"
    ExpiresByType application/json         "access plus 1 day"
    ExpiresByType application/xml          "access plus 1 day"
    ExpiresByType text/xml                 "access plus 1 day"
</IfModule>

# ── ETag Optimization ─────────────────────────────────────
FileETag MTime Size

# ── Prevent Image Hotlinking ──────────────────────────────
<IfModule mod_rewrite.c>
    RewriteCond %{HTTP_REFERER} !^$
    RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?localhost [NC]
    RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?appsgain\.in [NC]
    RewriteRule \.(jpg|jpeg|png|gif|webp)$ - [NC,F,L]
</IfModule>
